VITE_TTS_ENDPOINT=http://localhost:8765/speak

# The Jarvis agent backend's chat endpoint (src/jarvis/server.py, started via
# `jarvis-server`). This is what carries real reasoning/tool-calling — see
# src/lib/backend.ts's getAgentResponse().
VITE_AGENT_ENDPOINT=http://localhost:8000/chat

# The Jarvis agent backend's check-in endpoint -- polled once on launch to
# see if a morning/evening check-in is due (see src/jarvis/checkin.py and
# src/lib/backend.ts's getCheckin()). Falls back to the static time-of-day
# greeting when it returns null.
VITE_CHECKIN_ENDPOINT=http://localhost:8000/checkin

# Local address of the Jarvis HUD dev server itself (this app), started via
# `npm run dev`. Not read by the app (Vite serves here regardless) — kept
# here purely as a reference for where to open it in a browser.
VITE_DEV_SERVER_URL=http://localhost:5173
